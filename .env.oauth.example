# OAuth environment template — DO NOT place real values in this file.
# Obtain all values from your chosen OAuth identity provider.
OAUTH_ISSUER=https://YOUR-AUTH-PROVIDER.example/
OAUTH_AUDIENCE=YOUR_MCP_RESOURCE_IDENTIFIER
OAUTH_REQUIRED_SCOPE=mcp:tools
# Keep MCP_BEARER_TOKEN configured until OAuth is implemented and tested.
